{
  "name": "havantechno",
  "version": "0.2.0",
  "description": "Havantechno: a remix DAW (web and Electron, plain JavaScript, no bundler)",
  "main": "shell/main.js",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node ../tools/serve.js",
    "icon": "node build/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "author": "Havantechno contributors",
  "homepage": "https://github.com/CarlosFranzetti/havantechno",
  "build": {
    "appId": "io.github.carlosfranzetti.havantechno",
    "productName": "Havantechno",
    "copyright": "Copyright (c) Havantechno contributors. AGPL-3.0-or-later.",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "package.json",
      "index.html",
      "engine/**/*",
      "ui/**/*",
      "analysis/**/*",
      "solo/**/*",
      "shell/**/*"
    ],
    "extraResources": [
      {
        "from": "../tools/separate.py",
        "to": "tools/separate.py"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "artifactName": "Havantechno-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "AudioVideo;Audio;Midi",
      "maintainer": "Havantechno contributors <noreply@example.invalid>",
      "synopsis": "A remix DAW",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosFranzetti/havantechno.git"
  }
}
