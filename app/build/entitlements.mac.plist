<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by electron-builder for the macOS build only when it signs with a real certificate (the hardened runtime is on
     then). Electron needs the two memory entitlements; audio-input lets the page list output devices by name. Not
     tested on a Mac. Plug-in hosting (a later version) will also need com.apple.security.cs.disable-library-validation. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
